# mise installs itself here; sourced from .zprofile before mise is activated.
[[ ":$PATH:" == *":$HOME/.local/bin:"* ]] || export PATH="$HOME/.local/bin:$PATH"

[[ ":$PATH:" == *":$HOME/.bun/bin:"* ]] || export PATH="$PATH:$HOME/.bun/bin"

{{ if eq .chezmoi.os "darwin" -}}
# `mise bootstrap` pours homebrew/core bottles into this prefix without
# installing Homebrew, so there is no `brew shellenv` to evaluate.
export HOMEBREW_PREFIX=/opt/homebrew

[[ ":$PATH:" == *":${HOMEBREW_PREFIX}/bin:"* ]] || export PATH="${HOMEBREW_PREFIX}/bin:${HOMEBREW_PREFIX}/sbin:$PATH"
[[ ":${MANPATH:-}:" == *":${HOMEBREW_PREFIX}/share/man:"* ]] || export MANPATH="${HOMEBREW_PREFIX}/share/man:${MANPATH:-}"

[[ "${CPPFLAGS:-}" == *"${HOMEBREW_PREFIX}/include"* ]] || export CPPFLAGS="-I${HOMEBREW_PREFIX}/include ${CPPFLAGS:-}"
[[ "${LDFLAGS:-}" == *"${HOMEBREW_PREFIX}/lib"* ]] || export LDFLAGS="-L${HOMEBREW_PREFIX}/lib ${LDFLAGS:-}"
[[ "${PKG_CONFIG_PATH:-}" == *"${HOMEBREW_PREFIX}/lib/pkgconfig"* ]] || export PKG_CONFIG_PATH="${HOMEBREW_PREFIX}/lib/pkgconfig${PKG_CONFIG_PATH:+:${PKG_CONFIG_PATH}}"
{{- end }}
