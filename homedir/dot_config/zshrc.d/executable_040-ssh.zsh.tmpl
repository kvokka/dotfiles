{{ if eq .chezmoi.os "linux" }}
SSH_ENV="$HOME/.ssh/agent.env"
SSH_KEYS_DIR="$HOME/.secrets/ssh"

function _start_ssh_agent() {
  echo "Starting new ssh-agent..."
  ssh-agent -s > "$SSH_ENV"
  chmod 600 "$SSH_ENV"
  source "$SSH_ENV" >/dev/null
  _add_ssh_keys
}

function _add_ssh_keys() {
  for key in "$SSH_KEYS_DIR"/*; do
    [[ -f "$key" && "$key" != *.pub ]] && ssh-add "$key" 2>/dev/null
  done
}

if [[ -f "$SSH_ENV" ]]; then
  source "$SSH_ENV" >/dev/null

  if ! kill -0 "$SSH_AGENT_PID" 2>/dev/null || [[ ! -S "$SSH_AUTH_SOCK" ]]; then
    _start_ssh_agent
  else
    ssh-add -l >/dev/null 2>&1 || _add_ssh_keys
  fi
else
  _start_ssh_agent
fi
{{ end }}
