#!/bin/sh
# prek's hooks of the stage this file is named after (post-commit; post-merge is a link to it).
# A post-* hook cannot undo the commit or the merge, so it never fails the git command.
stage=$(basename "$0")
ROOT=$(git rev-parse --show-toplevel) || exit 0
if [ -f "$ROOT/.pre-commit-config.yaml" ]; then
  prek run --stage "$stage" || true
else
  prek run --stage "$stage" --config "$HOME/.config/pre-commit/pre-commit-config.yaml" || true
fi
