// pi profile `cm` (cass-memory's LLM, run by ~/.config/fw/bin/cm-llm): the
// proxy Codex uses (`myproxy` in ~/.codex/config.toml). pi interpolates $VAR
// only in apiKey and headers, not in baseUrl, so baseUrl is rendered by chezmoi
// from the same data as the Codex config. Only what differs from pi's model
// defaults: reasoning (else thinking is clamped to off) and the limits of pi's
// bundled catalog entry for gpt-6-luna.
{
  "providers": {
    "myproxy": {
      "baseUrl": {{ .my_cli_llm_proxy.url | toJson }},
      "api": "openai-responses",
      "apiKey": "$MY_CLI_LLM_PROXY_API_KEY",
      "models": [
        { "id": "gpt-6-luna", "reasoning": true, "contextWindow": 272000, "maxTokens": 128000 }
      ]
    }
  }
}
