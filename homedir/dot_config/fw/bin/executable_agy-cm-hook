#!/usr/bin/env bash
# Adds agy's cass-memory hook to ~/.gemini/config/hooks.json; the second step
# of `mise run ai:sync`, right after `rulesync generate` rewrote that file.
#
# agy has no prompt event, so cm-context-hook runs on PreInvocation (before
# every model call) and injects the context once per conversation. It cannot
# come from rulesync: rulesync nests PreInvocation as `{"hooks": [...]}`, agy
# reads it as a flat `[{type, command}]` list and then rejects the whole
# "rulesync" named hook, dcg included (agy 1.2.7). So it is a named hook of its
# own, `cass-memory`, next to rulesync's; rulesync drops other keys of the file
# on every run, hence this step. Hooks in agy's settings.json are not loaded.

set -euo pipefail

file="$HOME/.gemini/config/hooks.json"
[[ -f "$file" ]] || exit 0
hook="$HOME/.config/fw/bin/cm-context-hook"

tmp="$(mktemp "$file.XXXXXX")"
jq --arg cmd "$hook" \
  '.["cass-memory"] = {PreInvocation: [{type: "command", command: $cmd, timeout: 15}]}' \
  "$file" >"$tmp"
mv "$tmp" "$file"
