#!/usr/bin/env python3
"""cass-memory trauma guard: a PreToolUse hook for shell commands.

Blocks a shell command that matches an active trauma, a regex the owner
registered after a command caused real damage (`cm trauma add`). Wired by
~/.config/rulesync for Claude Code, Codex and agy, and by the OpenCode plugin
~/.config/opencode/plugins/cass-memory.js.

Our copy of cass-memory's trauma_guard.py (`cm guard --install`). Upstream (at
3e4c814, #82) now finds the store like cm does, but still reads the project
from the process cwd, knows only Claude's input and tells the agent to heal the
trauma itself, so this keeps:
  * global traumas: traumas.jsonl in $CASS_MEMORY_HOME (else
    $XDG_DATA_HOME/cass-memory, else ~/.cass-memory) and in the store chezmoi
    rendered this file for, so a client started without the mise env is still
    guarded (upstream bakes the install-time dir the same way);
  * project traumas: <git root>/.cass/traumas.jsonl (`--scope project`), the
    git root taken from the hook input's cwd (agy: its first workspace path);
    OpenCode and agy do not run the hook inside the repository;
  * input and verdict in each client's format: Claude Code and Codex send
    `tool_name` + `tool_input.command` and read `hookSpecificOutput`; agy sends
    `toolCall.args.CommandLine` and reads `{"decision": ...}`, and takes an
    answer without a decision (even `{}`) as a deny, so it always gets one;
  * the deny tells the agent to ask the owner, never to heal a trauma.
Only `status: active` entries count (`cm trauma heal <id>` deactivates one).
Matching is a case-insensitive `re.search` against the whole command and each
of its segments split on newlines, `&&`, `||`, `;` and `|` (as `cm audit
--trauma` splits them), so `^rm ...` also catches `cd x && rm ...`. Undecodable
bytes are replaced, and every failure allows the command: a broken guard must
not stop work; dcg stays the hard gate.
"""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

# The store this guard was rendered for (chezmoi, config.fw.toml CASS_MEMORY_HOME).
INSTALLED_GLOBAL_DIR = "{{ .chezmoi.homeDir }}/proj/share/cm-playbooks"
STATE = {"agy": False, "decided": False}
SEGMENT_SPLIT = re.compile(r"\r?\n|&&|\|\||;|\|")
SEGMENT_PREFIX = re.compile(r"^(?:sudo|exec|time|nohup|command)\s+")


def expand_home(value):
    """`~`, `~/x` and `~x` all under $HOME, as cm's expandPath."""
    if not value.startswith("~"):
        return Path(value)
    home = os.environ.get("HOME") or str(Path.home())
    rest = value[1:].lstrip("/")
    return Path(home) / rest if rest else Path(home)


def global_dirs():
    if os.environ.get("CASS_MEMORY_HOME"):
        env_dir = expand_home(os.environ["CASS_MEMORY_HOME"])
    elif os.environ.get("XDG_DATA_HOME"):
        env_dir = expand_home(os.environ["XDG_DATA_HOME"]) / "cass-memory"
    else:
        env_dir = expand_home("~/.cass-memory")
    dirs, seen = [], set()
    for d in (env_dir, Path(INSTALLED_GLOBAL_DIR)):
        key = os.path.realpath(d)
        if key not in seen:
            seen.add(key)
            dirs.append(d)
    return dirs


def git_root(cwd):
    try:
        out = subprocess.run(
            ["git", "-C", cwd, "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, timeout=3,
        )
    except Exception:
        return None
    return Path(out.stdout.strip()) if out.returncode == 0 and out.stdout.strip() else None


def active_traumas(path):
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except (OSError, ValueError):
        return []
    found = []
    for line in lines:
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if isinstance(entry, dict) and entry.get("status") == "active" and entry.get("pattern"):
            found.append(entry)
    return found


def candidates(command):
    """The whole command, then each segment without a leading `(`/`{` or sudo-like prefix."""
    yield command
    for part in SEGMENT_SPLIT.split(command):
        part = SEGMENT_PREFIX.sub("", re.sub(r"^[({]\s*", "", part.strip())).strip()
        if part and part != command:
            yield part


def main():
    try:
        data = json.load(sys.stdin)
    except ValueError:
        return
    if not isinstance(data, dict):
        return

    agy = STATE["agy"] = isinstance(data.get("toolCall"), dict)
    if agy:
        call = data["toolCall"]
        if call.get("name") != "run_command":
            return
        command = (call.get("args") or {}).get("CommandLine")
        paths = data.get("workspacePaths") or []
        cwd = paths[0] if paths else os.getcwd()
    else:
        if data.get("tool_name") not in ("Bash", "run_command"):
            return
        command = (data.get("tool_input") or {}).get("command")
        cwd = data.get("cwd") or os.getcwd()
    if not isinstance(command, str) or not command:
        return

    traumas = []
    for d in global_dirs():
        traumas += active_traumas(d / "traumas.jsonl")
    root = git_root(cwd)
    if root:
        traumas += active_traumas(root / ".cass" / "traumas.jsonl")

    parts = list(candidates(command))
    for trauma in traumas:
        try:
            rx = re.compile(trauma["pattern"], re.IGNORECASE)
        except (re.error, TypeError):
            continue
        if not any(rx.search(part) for part in parts):
            continue
        trigger = trauma.get("trigger_event") if isinstance(trauma.get("trigger_event"), dict) else {}
        reason = (
            "BLOCKED by a cass-memory trauma: this command matches a pattern that "
            "already caused real damage.\n"
            f"Pattern: {trauma['pattern']}\n"
            f"Why: {trigger.get('human_message') or 'no reason recorded'}\n"
            f"Incident: {trigger.get('session_path') or 'unknown'}\n"
            f"Trauma id: {trauma.get('id', 'unknown')} ({trauma.get('severity', 'CRITICAL')})\n"
            "Do another way that avoids the pattern. Never heal, remove or edit a "
            "trauma yourself; if this command is truly required, stop and ask the owner."
        )
        if agy:
            print(json.dumps({"decision": "deny", "reason": reason}))
        else:
            print(json.dumps({"hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": "deny",
                "permissionDecisionReason": reason,
            }}))
        STATE["decided"] = True
        return


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    if STATE["agy"] and not STATE["decided"]:
        print(json.dumps({"decision": "allow"}))
    sys.exit(0)
