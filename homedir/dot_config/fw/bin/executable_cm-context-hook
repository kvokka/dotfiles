#!/usr/bin/env bash
# cass-memory context for the first prompt of a session: what `cm context`
# finds for the prompt (rules, pitfalls, related sessions), printed once per
# session. A UserPromptSubmit hook in Claude Code and Codex (~/.config/rulesync),
# whose plain stdout reaches the model; OpenCode's cass-memory plugin passes
# the same input. A slash command is not a prompt. The workspace is the
# repository's main checkout: cm merges its .cass/playbook.yaml into the global
# rules and filters history by it, so a worktree sees its repository's rules and
# sessions.

set -uo pipefail

input="$(cat)"
id="$(jq -r '.session_id // empty' <<<"$input")"
prompt="$(jq -r '.prompt // empty' <<<"$input")"
cwd="$(jq -r '.cwd // empty' <<<"$input")"
[[ -n "$id" && -n "$prompt" && "$prompt" != /* ]] || exit 0
mkdir -p /tmp/fw-cm-context && mkdir "/tmp/fw-cm-context/$id" 2>/dev/null || exit 0

repo="$(git -C "${cwd:-$PWD}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
cd "$HOME" && timeout 8 cm context "${prompt:0:600}" --limit 8 --history 3 \
  ${repo:+--workspace "${repo%/.git}"} --format markdown 2>/dev/null
exit 0
