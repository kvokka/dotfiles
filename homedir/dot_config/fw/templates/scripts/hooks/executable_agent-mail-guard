#!/usr/bin/env bash
# Pre-commit guard: refuse to commit files reserved by another agent in
# MCP Agent Mail. prek passes the staged file names as arguments.
#
# Environment:
#   AGENT_NAME             identity of the committer; defaults to human:<user>
#   AGENT_MAIL_GUARD_MODE  block (default) or warn
#   STORAGE_ROOT           must match the Agent Mail service (archive lookup)
# Skip for one commit: PREK_SKIP=agent-mail-guard git commit ...
set -euo pipefail

if ! command -v am >/dev/null 2>&1; then
  echo "agent-mail-guard: 'am' is not installed; reservation check skipped" >&2
  exit 0
fi

repo="$(git rev-parse --show-toplevel)"
export AGENT_NAME="${AGENT_NAME:-human:$(id -un)}"

args=(--stdin-nul --repo "$repo")
if [ "${AGENT_MAIL_GUARD_MODE:-block}" = "warn" ]; then
  args+=(--advisory)
fi

printf '%s\0' "$@" | am guard check "${args[@]}"
