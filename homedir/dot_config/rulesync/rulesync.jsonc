// Global MCP servers and hooks for every AI client, generated by rulesync into
// each client's own user-scope files. Edit the source trees next to this file,
// never the generated files, then run `mise run ai:sync`.
//
//   base/.rulesync  every machine: MCP servers only
//   fw/.rulesync    Linux devcontainer (flywheel stack): MCP servers + hooks
//
// `ai:sync` passes the targets, features, `--global` and the input roots on the
// command line; this file only documents the layout and keeps `rulesync`
// commands run here in user scope.
{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "global": true,
  "targets": ["claudecode", "codexcli", "opencode", "antigravity-cli"],
  "features": ["mcp", "hooks"],
}
