// MCP servers and hooks for every AI client in the Linux devcontainer, where all
// coding runs. `mise run ai:sync` (config.fw.toml) generates them from
// .rulesync/ next to this file into each client's user-scope files; edit the
// source there, never the generated files.
{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "global": true,
  "targets": ["claudecode", "codexcli", "opencode", "antigravity-cli"],
  "features": ["mcp", "hooks"],
}
