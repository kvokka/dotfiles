// Hooks for Claude Code, Codex and agy (OpenCode gets none, see rulesync.jsonc).
// rulesync replaces each client's hook list with this file, so every hook the
// clients should run is listed here.
{
  "version": 1,
  "hooks": {
    // trauma_guard.py is cass-memory's own guard (`cm guard --install`, copied
    // by fw:bootstrap): it blocks the patterns the owner registered after real
    // damage (`cm trauma add`). Only `Bash`: it answers nothing to agy's input
    // (`run_command`), and agy takes a silent PreToolUse hook as a deny. dcg is
    // no user-scope hook: it guards only the repositories fw:init prepared,
    // through their own hooks, so a chat session runs what the user asks for.
    "preToolUse": [
      { "matcher": "Bash", "command": "{{ .chezmoi.homeDir }}/.claude/hooks/trauma_guard.py", "timeout": 10 },
    ],
  },
}
