// Hooks for Claude Code, Codex and agy (OpenCode gets none, see rulesync.jsonc;
// its cass-memory plugin runs the same scripts). rulesync replaces each
// client's hook list with this file, so every hook the clients should run is
// listed here. An event a client lacks is dropped for it with a warning: agy
// has no sessionStart or beforeSubmitPrompt and gets its own block below.
{
  "version": 1,
  "hooks": {
    // Shell tool: `Bash` in Claude Code and Codex, `run_command` in agy. dcg
    // blocks generic destructive commands; trauma-guard blocks the patterns the
    // owner registered after real damage (`cm trauma add`).
    "preToolUse": [
      { "matcher": "Bash|run_command", "command": "{{ .chezmoi.homeDir }}/.local/share/mise/shims/dcg", "timeout": 10 },
      { "matcher": "Bash|run_command", "command": "{{ .chezmoi.homeDir }}/.config/fw/bin/trauma-guard", "timeout": 10 },
    ],
    // Instruction blocks of the local tools (~/.config/fw/instructions), one
    // hook per tool, each printed only where its tool applies; SessionStart
    // also fires after compaction, so they come back. Then Agent Mail state.
    // Claude Code and Codex show the model plain stdout only from SessionStart
    // and UserPromptSubmit, and from PostToolUse only a JSON
    // `additionalContext`; am-hook prints the one each event needs.
    "sessionStart": [
      { "command": "{{ .chezmoi.homeDir }}/.config/fw/bin/fw-context cm", "timeout": 10 },
      { "command": "{{ .chezmoi.homeDir }}/.config/fw/bin/fw-context cass", "timeout": 10 },
      { "command": "{{ .chezmoi.homeDir }}/.config/fw/bin/fw-context agent-mail", "timeout": 10 },
      { "command": "{{ .chezmoi.homeDir }}/.config/fw/bin/fw-context beads", "timeout": 10 },
      { "command": "{{ .chezmoi.homeDir }}/.config/fw/bin/fw-context ubs", "timeout": 10 },
      { "command": "{{ .chezmoi.homeDir }}/.config/fw/bin/am-hook session", "timeout": 10 },
    ],
    // cass-memory rules for the task, once, on the first prompt of a session.
    "beforeSubmitPrompt": [
      { "command": "{{ .chezmoi.homeDir }}/.config/fw/bin/cm-context-hook", "timeout": 15 },
    ],
    "postToolUse": [
      { "command": "{{ .chezmoi.homeDir }}/.config/fw/bin/am-hook inbox", "timeout": 10 },
    ],
  },
  // No agy `preModelInvocation` here: rulesync nests it as
  // `{"hooks": [{command}]}`, while agy reads PreInvocation as a flat
  // `[{type, command}]` list and then rejects the whole "rulesync" named hook,
  // dcg included ("command hook must specify 'command'", agy 1.2.7). The agy
  // cass-memory hook is its own named hook in the same file, added by
  // ~/.config/fw/bin/agy-cm-hook, the second step of `mise run ai:sync`; agy's
  // instruction blocks are always-on rules (~/.gemini/config/rules).
}
