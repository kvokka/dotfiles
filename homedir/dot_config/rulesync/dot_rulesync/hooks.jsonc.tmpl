// Hooks for Claude Code, Codex and agy (OpenCode gets none, see rulesync.jsonc).
// rulesync replaces each client's hook list with this file, so every hook the
// clients should run is listed here.
{
  "version": 1,
  "hooks": {
    // Shell tool: `Bash` in Claude Code and Codex, `run_command` in agy.
    // trauma_guard.py is cass-memory's own guard (`cm guard --install`, copied
    // by fw:bootstrap): it blocks the patterns the owner registered after real
    // damage (`cm trauma add`). Only `Bash`: it answers nothing to agy's input,
    // and agy takes a silent PreToolUse hook as a deny.
    "preToolUse": [
      { "matcher": "Bash|run_command", "command": "{{ .chezmoi.homeDir }}/.local/share/mise/shims/dcg", "timeout": 10 },
      { "matcher": "Bash", "command": "{{ .chezmoi.homeDir }}/.claude/hooks/trauma_guard.py", "timeout": 10 },
    ],
    // Instruction blocks of the local tools, then Agent Mail state. SessionStart
    // also fires after compaction, so the blocks come back. Claude Code and
    // Codex show the model plain stdout only from SessionStart and
    // UserPromptSubmit, and from PostToolUse only a JSON `additionalContext`;
    // am-hook prints the one each event needs. agy has neither SessionStart
    // nor UserPromptSubmit.
    {{- $i := printf "%s/.config/fw/instructions" .chezmoi.homeDir }}
    "sessionStart": [
      { "command": "cat {{ $i }}/cm.md {{ $i }}/cass.md {{ $i }}/agent-mail.md {{ $i }}/beads.md {{ $i }}/ubs.md", "timeout": 10 },
      { "command": "{{ .chezmoi.homeDir }}/.config/fw/bin/am-hook session", "timeout": 10 },
    ],
    // cass-memory rules for the task, once, on the first prompt of a session.
    "beforeSubmitPrompt": [
      { "command": "{{ .chezmoi.homeDir }}/.config/fw/bin/cm-context-hook", "timeout": 15 },
    ],
    "postToolUse": [
      { "command": "{{ .chezmoi.homeDir }}/.config/fw/bin/am-hook inbox", "timeout": 10 },
    ],
  },
}
