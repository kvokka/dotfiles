[env]

_.path = "./node_modules/.bin"

[tools]

nodejs = '26.8'
biome = '2.5'
bun = '1.4'
pnpm = '11.22'

"npm:aicommit2" = "latest"
"npm:diff-so-fancy" = "1.4" # not packaged for Ubuntu noble, and one source serves both hosts
"npm:fallow" = "v3.20"
"npm:@fission-ai/openspec" = "1.11"

golang = '1.27'

python = '3.14'
uv = '0.12'
ruff = '0.16'
ty = '0.0.75'
pipx = '1.16'

"pipx:hf" = "1.29"

prek = '0.4'
hadolint = '2.15'
shellcheck = '0.11'
gitleaks = '8.30'
rumdl = '0.2.58' # too often version bumps
vale = '3.14'

just = '1.58'
chezmoi = '2.72'
bat = '0.26'
gdu = '5.37' # ncdu has no release binaries at all
fzf = '0.74'
fd = '10.4'
jq = '1.8'
yq = '4.53'
ripgrep = '15.2'
direnv = '2.37'
zoxide = '0.10'
gh = '2.98'
oxlint = '1.77'
fnox = '1.33'

oras = '1.3'

sops = '3.13'
age = '1.3'

oh-my-posh = '30.6'

neovim = '0.12'

codex = '0'
opencode = '1.18'
claude = '2.1'
gcloud = 'latest'

docker-cli = '29.7'
terraform = '1.16'

# # # # # # extras
# ruby = '3.4'
# podman = '5.5'
# rust = '1'
# kubectl = '1.31'
# kubeseal = '0.28'
# k9s = '0.40'
# git-cliff = '2.8'
# helm = '4'
# helm-diff = '3'

[dotfiles]
"~/.cache/terraform/plugin-cache/.keep" = { content = "" }

[settings]

minimum_release_age = "3d"
minimum_release_age_excludes = ["opencode", "claude", "codex", "aqua:openai/codex"]

npm.package_manager = "bun"

idiomatic_version_file_enable_tools = ["python", "ruby"]

trusted_config_paths = ["~/proj/active"]

[settings.pipx]
uvx = true

[settings.python]
uv_venv_auto = "create|source"
