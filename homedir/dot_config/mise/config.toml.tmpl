[env]

_.path = "./node_modules/.bin"
BEADS_DIR = "{{ .chezmoi.homeDir }}/proj/share/beads" # configs
BEADS_SHARED_SERVER_DIR = "{{ .chezmoi.homeDir }}/proj/share/beads" # DB path
BEADS_DOLT_SHARED_SERVER=1
BD_JSON_ENVELOPE=1

[tools]

nodejs = '26.8'
biome = '2.5'
bun = '1.4'
pnpm = '12.4.0'

"npm:aicommit2" = "latest"
"npm:diff-so-fancy" = "1.4" # not packaged for Ubuntu noble, and one source serves both hosts
"npm:fallow" = "v3.26"
"npm:@fission-ai/openspec" = { version = "1.13", postinstall = "openspec completion install zsh" }

golang = '1.27'

python = '3.14'
uv = '0.12'
ruff = '0.16'
ty = '0.0.81'
pipx = '1.16'

"pipx:hf" = "1.31"

prek = '0.5'
hadolint = '2.15'
shellcheck = '0.11'
gitleaks = '8.30'
rumdl = '0.2.70' # too often version bumps
vale = '3.14'

chezmoi = '2.72'
bat = '0.26'
gdu = '5.37' # ncdu has no release binaries at all
fzf = '0.74'
fd = '10.4'
jq = '1.8'
yq = '4.53'
ripgrep = '15.2'
direnv = '2.37'
zoxide = '0.10'
gh = '2.101.0'
oxlint = '1.82'
fnox = '1.35'

oras = '1.3'

sops = '3.13'
age = '1.3'

oh-my-posh = 'v31.2.1'

neovim = '0.12'

gcloud = 'latest'

docker-cli = '29.8'
terraform = '1.16'

atuin = '18.22'
lsd = '1.2'

"github:gastownhall/beads" = { version = "1.3.0", os = "linux"}
"aqua:dolthub/dolt" = { version = "2.3.4", os = "linux"}
opencode = { version = "1.18", os = "linux"}
codex = { version = "0", os = "linux"}
claude = { version = "2.1", os = "linux"}
just = { version = "1.58", os = "linux"}
ast-grep = { version = "0.45", os = "linux"}

cloc = { version = "2.10", bin = "cloc", asset_pattern = "cloc-{{ "{{ version }}" }}.pl" }

# # # # # # extras
# ruby = '3.4'
# podman = '5.5'
# rust = '1'
# kubectl = '1.31'
# kubeseal = '0.28'
# k9s = '0.40'
# git-cliff = '2.8'
# helm = '4'
# helm-diff = '3'

[dotfiles]
"~/.cache/terraform/plugin-cache/.keep" = { content = "" }

[settings]

minimum_release_age = "3d"
minimum_release_age_excludes = ["opencode", "claude", "codex", "aqua:openai/codex"]

npm.package_manager = "bun"

idiomatic_version_file_enable_tools = ["python", "ruby"]

trusted_config_paths = ["~/proj/active"]

[settings.pipx]
uvx = true

[settings.python]
uv_venv_auto = "source"

[tasks."openspec:setup:stores"]
description = "Setup all openspec stores"
run = "openspec store register ~/proj/active/siam-platform"

[tasks.bootstrap]
description = "Global mise bootstrap"
run = "fnox exec -- mise run bootstrap:atuin"

[tasks."bootstrap:atuin"]
hide = true
run = """
[ -n "${ATUIN_KEY:-}" ] && [ -n "${ATUIN_PASSWORD:-}" ] || { echo "skip: no ATUIN_KEY/ATUIN_PASSWORD"; exit 0; }
atuin status >/dev/null 2>&1 || atuin login -u "${ATUIN_USERNAME:-kvokka}" -p "$ATUIN_PASSWORD" -k "$ATUIN_KEY"

d="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/atuin"
mkdir -p "$d"
atuin gen-completions --shell zsh --out-dir "$d"
cat > "$d/atuin.plugin.zsh" <<'EOF'
(( $+commands[atuin] )) || return
eval "$(atuin init zsh --disable-up-arrow)"
EOF
rm -f "$HOME"/.zcompdump*

atuin sync
"""
