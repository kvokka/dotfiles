# auto_update = true # disabed until re-install on both macOS & linux from install script

[env]

_.path = ['{{ "{{config_root}}" }}/node_modules/.bin']

[tools]

nodejs = '26.7.0'
biome = '2.5'
bun = '1.4'
pnpm = '11.22'

"npm:aicommit2" = "latest"
"npm:diff-so-fancy" = "1.4" # not packaged for Ubuntu noble, and one source serves both hosts
"npm:fallow" = "v3.17"
"npm:@fission-ai/openspec" = "1.10"

golang = '1.26'

python = '3.14'
uv = '0.12'
ruff = '0.16'
ty = '0.0.69'
pipx = '1.16'

"pipx:hf" = "1.28"

prek = '0.4'
hadolint = '2.15'
shellcheck = '0.11'
gitleaks = '8.30'
rumdl = '0.2.58' # too often version bumps
vale = '3.14'

just = '1.58'
chezmoi = '2.72'
bat = '0.26'
btop = { os = "linux", version = '1.4' } # upstream releases linux binaries only, macOS pours the bottle
gdu = '5.37' # ncdu has no release binaries at all
fzf = '0.74'
fd = '10.4'
jq = '1.8'
yq = '4.53'
ripgrep = '15.2'
direnv = '2.37'
zoxide = '0.10'
gh = '2.98'
oxlint = '1.77'
fnox = '1.33'

oras = '1.3'

sops = '3.13'
age = '1.3'

oh-my-posh = '30.6'

neovim = '0.12'

codex = '0'
opencode = '1.18'
claude = '2.1'
gcloud = 'latest'

mas = { os = "macos", version = "7" }

docker-cli =  { os = "linux", version = '29.7' }
# "npm:openclaw" = { os = "linux" }
"npm:agent-browser" = { os = "linux", version = "latest" }

{{ if not .headless }}
dive = '0.13'
terraform = '1.15'
cosign = '3'
helm = '4'
helm-diff = '3'
{{ end }}

