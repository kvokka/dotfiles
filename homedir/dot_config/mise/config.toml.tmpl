auto_update = true

[env]

_.path = ['{{ "{{config_root}}" }}/node_modules/.bin']

[tools]

nodejs = '26.7.0'
biome = '2.5'
bun = '1.4'
pnpm = '11.22'

"npm:aicommit2" = "latest"
"npm:fallow" = "v3.17"
"npm:@fission-ai/openspec" = "1.10"

golang = '1.26'

python = '3.14'
uv = '0.12'
ruff = '0.16'
ty = '0.0.69'
pipx = '1.16'

"pipx:hf" = "1.28"

prek = '0.4'
hadolint = '2.15'
shellcheck = '0.11'
gitleaks = '8.30'
rumdl = '0.2.58' # too often version bumps
vale = '3.14'

just = '1.58'
chezmoi = '2.72'
bat = '0.26'
fzf = '0.74'
fd = '10.4'
jq = '1.8'
yq = '4.53'
ripgrep = '15.2'
direnv = '2.37'
zoxide = '0.10'
gh = '2.98'
oxlint = '1.77'
fnox = '1.33'

oras = '1.3'

sops = '3.13'
age = '1.3'

oh-my-posh = '30.6'

neovim = '0.12'

codex = '0'
opencode = '1.18'
claude = '2.1'
gcloud = 'latest'

{{- if eq .chezmoi.os "linux" }}
docker-cli = '29.7'
# "npm:openclaw" = "latest" # use npm for now, since with bun it fails
"npm:agent-browser" = "latest"
{{- end }}

{{ if not .headless }}
dive = '0.13'
terraform = '1.15'
cosign = '3'
helm = '4'
helm-diff = '3'
{{ end }}

# # # # # # extras
# ruby = '3.4'
# podman = '5.5'
# rust = '1'
# kubectl = '1.31'
# kubeseal = '0.28'
# k9s = '0.40'
# git-cliff = '2.8'

# Host packages, applied by `mise bootstrap`. On macOS mise pours homebrew/core
# bottles into /opt/homebrew itself, so Homebrew is never installed. The Linux
# image carries its own compiler and media stack in the Dockerfile; only the
# packages a bare Linux host also needs are declared here.
[bootstrap.packages]

"apt:coreutils" = { os = "linux" }
"apt:curl" = { os = "linux" }
"apt:diff-so-fancy" = { os = "linux" }
"apt:git" = { os = "linux" }
"apt:gnupg" = { os = "linux" }
"apt:htop" = { os = "linux" }
"apt:make" = { os = "linux" }
"apt:ncdu" = { os = "linux" }
"apt:tig" = { os = "linux" }
"apt:tree" = { os = "linux" }
"apt:wget" = { os = "linux" }
"apt:zsh" = { os = "linux" }
"apt:sudo" = { os = "linux" }
"apt:libasound2t64" = { os = "linux" } # libasound2t64
"apt:binutils" = { os = "linux" } #jpackage
"apt:fakeroot" = { os = "linux" } #jpackage
"apt:libc6" = { os = "linux" } #jpackage
"apt:imagemagick" = { os = "linux" } #jpackage
"apt:gcc" = { os = "linux" } #jpackage
"apt:bubblewrap" = { os = "linux" }
"apt:bubblewrap" = { os = "keychain" }
"apt:socat" = { os = "linux" } # claude code

"brew:coreutils" = { os = "macos" }
"brew:curl" = { os = "macos" }
"brew:diff-so-fancy" = { os = "macos" }
"brew:docker-credential-helper" = { os = "macos" }
"brew:dockutil" = { os = "macos" }
"brew:git" = { os = "macos" }
"brew:gnupg" = { os = "macos" }
"brew:htop" = { os = "macos" }
"brew:make" = { os = "macos" }
"brew:ncdu" = { os = "macos" }
"brew:tig" = { os = "macos" }
"brew:tree" = { os = "macos" }
"brew:wget" = { os = "macos" }
"brew:zsh" = { os = "macos" }

{{- if not .headless }}

"brew-cask:ghostty@tip" = { os = "macos" }
{{- end }}

{{- if .personal }}

# Casks reach Linux only as fonts; mise skips the rest there.
"brew-cask:font-meslo-lg-nerd-font" = "latest"  # p10k font `MesloLGM NF`

"brew-cask:firefox" = { os = "macos" }
"brew-cask:google-chrome" = { os = "macos" }
"brew-cask:telegram" = { os = "macos" }
"brew-cask:transmission" = { os = "macos" }
"brew-cask:veracrypt" = { os = "macos" } # pulls the macfuse cask, which needs a kernel extension approval
"brew-cask:visual-studio-code" = { os = "macos" }
"brew-cask:vlc" = { os = "macos" }
# "brew-cask:whatsapp" = { os = "macos" }
{{- end }}

{{- if and (eq .chezmoi.os "linux") (not .ephemeral) }}

[bootstrap.user]

login_shell = "/usr/bin/zsh"
{{- end }}

{{- if eq .chezmoi.os "darwin" }}

[bootstrap.macos.dock]
autohide = false
orientation = bottom
largesize = 128

[bootstrap.macos.finder]
show_extensions_warning = false
preferred_view_style = list
show_status_bar = false
show_pathbar = true
show_all_files = true

[bootstrap.macos.keyboard]
key_repeat = 1
initial_key_repeat = 25
press_and_hold = false

[bootstrap.macos.trackpad]
tap_to_click = true
three_finger_drag = true

[bootstrap.macos.defaults]
"com.apple.Accessibility" = { KeyRepeatDelay = 0.416666666 }
"com.apple.Accessibility" = { KeyRepeatInterval = 0.016666666 }
"NSGlobalDomain" = { NSAutomaticCapitalizationEnabled = 1 }
"NSGlobalDomain" = { NSAutomaticDashSubstitutionEnabled = 1 }
"NSGlobalDomain" = { NSAutomaticPeriodSubstitutionEnabled = 1 }
"NSGlobalDomain" = { NSAutomaticSpellingCorrectionEnabled = 1 }
"NSGlobalDomain" = { NSAutomaticQuoteSubstitutionEnabled = 1 }
"NSGlobalDomain" = { NSAutomaticSpellingCorrectionEnabled = 1 }
"NSGlobalDomain" = { NSDocumentSaveNewDocumentsToCloud = 0 }
"NSGlobalDomain" = { WebAutomaticSpellingCorrectionEnabled = 1 }
"com.apple.AppleMultitouchTrackpad" = { TrackpadRightClick = 1 }
"com.apple.AppleMultitouchTrackpad" = { ForceSuppressed = 0 }

[bootstrap.hooks]

post-defaults = "killall Dock || true"
{{- end }}

[settings]

minimum_release_age = "3d"
minimum_release_age_excludes = ["opencode", "claude", "codex", "aqua:openai/codex"]

npm.package_manager = "bun"

{{ if .ephemeral }}
yes = true
{{ end }}

idiomatic_version_file_enable_tools = ["python", "ruby"]


{{- $paths := list }}
{{- $paths = append $paths (joinPath .chezmoi.homeDir "proj/active") }}

{{- if eq .chezmoi.os "linux" }}
{{-   $paths = append $paths "/workspace" -}}
{{- end }}

trusted_config_paths = [{{ if $paths }}
{{- range compact $paths }}
  "{{ . }}",
{{- end }}
{{- end }}
]

[settings.pipx]
uvx = true

[settings.python]
uv_venv_auto = "create|source"
