#!/usr/bin/env bash
#MISE description="Smoke-check the flywheel agent stack (read-only)"
#MISE dir="{{cwd}}"
#
# Every check prints ok/FAIL and the task exits non-zero when any check failed.
# Nothing is installed or fixed here; see the remediation printed next to a FAIL.

set -uo pipefail

failed=0
check() { # check <label> <command...>
  local label="$1"; shift
  if "$@" >/dev/null 2>&1; then
    printf 'ok   %s\n' "$label"
  else
    printf 'FAIL %s  (%s)\n' "$label" "$*"
    failed=1
  fi
}
dcg_shim="$HOME/.local/share/mise/shims/dcg"
fwbin="$HOME/.config/fw/bin"
# The trauma guard must deny a registered pattern, in Claude's and agy's format,
# also inside a chained command and despite an undecodable line in the store:
# a throwaway store with one active trauma.
trauma_probe() {
  local store rc=0
  store="$(mktemp -d)" || return 1
  printf 'bad \xff line\n%s\n' '{"id":"probe","pattern":"^doctor-probe","status":"active"}' >"$store/traumas.jsonl"
  printf '%s' '{"tool_name":"Bash","tool_input":{"command":"cd / && doctor-probe x"},"cwd":"/"}' |
    CASS_MEMORY_HOME="$store" "$fwbin/trauma-guard" |
    jq -e '.hookSpecificOutput.permissionDecision == "deny"' || rc=1
  printf '%s' '{"toolCall":{"name":"run_command","args":{"CommandLine":"doctor-probe x"}},"workspacePaths":["/"]}' |
    CASS_MEMORY_HOME="$store" "$fwbin/trauma-guard" | jq -e '.decision == "deny"' || rc=1
  rm -f "$store/traumas.jsonl" && rmdir "$store"
  return "$rc"
}

for tool in ntm br bv am dcg ubs cass cm pi ru jfp brenner sbh aadc agy pitchfork toon typos fmd rulesync; do
  check "tool: $tool" command -v "$tool"
done

check "dcg shim exists (hooks point at it)" test -x "$dcg_shim"
check "dcg denies 'git reset --hard'" bash -c \
  "printf '%s' '{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"git reset --hard\"}}' | \"$dcg_shim\" | jq -e '.hookSpecificOutput.permissionDecision == \"deny\"'"
# `dcg doctor` accepts only its own versioned binary path in a hook (the
# `hook_wiring` check); the hooks point at the version-independent mise shim,
# verified above, so that check is skipped here. `allowlists` warns whenever
# no allowlist file exists, which is the intended state.
check "dcg doctor (config, packs, smoke test)" bash -c \
  "dcg doctor --format json | jq -e '[.checks[] | select(.id | IN(\"hook_wiring\", \"allowlists\", \"codex_hook\") | not) | select(.status != \"ok\")] | length == 0'"
check "codex trusts the dcg hook (approve once in Codex, then copy [hooks.state] into private_config.toml.tmpl)" bash -c \
  "dcg doctor --format json | jq -e '.checks[] | select(.id == \"codex_hook\") | .status == \"ok\"'"
# Hooks and MCP servers below are generated by `mise run ai:sync` (rulesync);
# a FAIL there is fixed by running it, not by editing the client file.
check "claude hook registered" jq -e '.hooks.PreToolUse[]?.hooks[]? | select(.command == "'"$dcg_shim"'")' "$HOME/.claude/settings.json"
check "codex hook registered" jq -e '.hooks.PreToolUse[]?.hooks[]? | select(.command == "'"$dcg_shim"'")' "$HOME/.codex/hooks.json"
check "opencode dcg plugin present" grep -q dcg-opencode-plugin "$HOME/.config/opencode/plugins/dcg-guard.js"
check "agy settings pinned" jq -e '.toolPermission == "always-proceed"' "$HOME/.gemini/antigravity-cli/settings.json"
check "agy hook registered" jq -e '.rulesync.PreToolUse[]?.hooks[]? | select(.command == "'"$dcg_shim"'")' "$HOME/.gemini/config/hooks.json"
servers='has("mcp-agent-mail") and has("cass-memory")'
check "claude MCP: mcp-agent-mail, cass-memory" jq -e ".mcpServers | $servers" "$HOME/.claude.json"
check "codex MCP: mcp-agent-mail, cass-memory" bash -c \
  "for s in mcp-agent-mail cass-memory; do grep -q \"^\\[mcp_servers\\.\$s\\]\" ~/.codex/config.toml || exit 1; done"
check "agy MCP: mcp-agent-mail, cass-memory" jq -e ".mcpServers | $servers" "$HOME/.gemini/config/mcp_config.json"

# Agent instructions and cass-memory hooks (rulesync, agy-cm-hook, the OpenCode
# plugin and instructions); a hook FAIL is fixed by `mise run ai:sync`.
for block in cm cass agent-mail beads ubs; do
  check "instruction block: $block" test -s "$HOME/.config/fw/instructions/$block.md"
done
for client in "$HOME/.claude/settings.json" "$HOME/.codex/hooks.json"; do
  check "hooks in $client: trauma-guard, fw-context, cm-context-hook" jq -e \
    --arg g "$fwbin/trauma-guard" --arg c "$fwbin/fw-context cm" --arg p "$fwbin/cm-context-hook" \
    '[.hooks[][]?.hooks[]?.command] | (index($g) != null) and (index($c) != null) and (index($p) != null)' "$client"
done
check "agy hooks: trauma-guard (rulesync), cass-memory PreInvocation (agy-cm-hook)" jq -e \
  --arg g "$fwbin/trauma-guard" --arg p "$fwbin/cm-context-hook" \
  '([.rulesync.PreToolUse[]?.hooks[]?.command] | index($g) != null) and (."cass-memory".PreInvocation[0].command == $p)' \
  "$HOME/.gemini/config/hooks.json"
check "agy always-on rule with the instruction blocks" grep -q 'trigger: always_on' "$HOME/.gemini/config/rules/fw-agent-stack.md"
check "opencode cass-memory plugin" test -f "$HOME/.config/opencode/plugins/cass-memory.js"
check "opencode instructions include the blocks" grep -q 'fw/instructions' "$HOME/.config/opencode/opencode.json"
check "trauma-guard denies an active trauma" trauma_probe

check "pitchfork: agent-mail running" bash -c "pitchfork status agent-mail | grep -q running"
check "pitchfork: cm running" bash -c "pitchfork status cm | grep -q running"
check "pitchfork: sbh running" bash -c "pitchfork status sbh | grep -q running"
check "agent-mail /health ready" curl -fsS http://127.0.0.1:8765/health
check "am doctor check" am doctor check --json
check "cm serve answers tools/list" bash -c \
  "curl -fsS -X POST http://127.0.0.1:8766 -H 'content-type: application/json' -d '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}' | jq -e '.result.tools | length > 0'"
check "cm doctor" cm doctor --json
check "cm store is a git repository (\$CASS_MEMORY_HOME)" test -d "${CASS_MEMORY_HOME:-/nonexistent}/.git"
check "cm config: provider cli through cm-llm" yq -e '.provider == "cli" and (.cliCommand | test("cm-llm$"))' \
  "${CASS_MEMORY_HOME:-/nonexistent}/config.yaml"
check "pi profile cm rendered (~/.config/fw/pi/cm/models.json)" test -s "$HOME/.config/fw/pi/cm/models.json"
# One tiny LLM call through pi and the proxy; fnox holds the key.
check "cm-llm answers through pi and the proxy" bash -c \
  "echo 'Reply with the single word: pong' | fnox exec -- '$fwbin/cm-llm' | grep -qi pong"
check "pitchfork: cm-reflect scheduled, last run ok (pitchfork logs cm-reflect)" bash -c \
  "pitchfork status cm-reflect | grep -q -E 'Status: (running|stopped)'"
check "pitchfork: cm-trauma-scan scheduled, last run ok (pitchfork logs cm-trauma-scan)" bash -c \
  "pitchfork status cm-trauma-scan | grep -q -E 'Status: (running|stopped)'"
check "cass health (run 'mise run fw:cass-index' once if FAIL)" cass health --json
check "cass index fresh (cass-index daemon: mise daemons restart cass-index)" bash -c \
  "cass status --json | jq -e '.index.stale == false'"
# A cron daemon is `stopped` between successful runs and `errored` after a
# failed one; the supervisor runs it on schedule either way.
check "pitchfork: cass-index scheduled, last run ok" bash -c \
  "pitchfork status cass-index | grep -q -E 'Status: (running|stopped)'"
check "pitchfork: cass-nightly scheduled, last run ok (pitchfork logs cass-nightly)" bash -c \
  "pitchfork status cass-nightly | grep -q -E 'Status: (running|stopped)'"
check "cass model installed: ${CASS_SEMANTIC_EMBEDDER:-unset} (mise run fw:bootstrap)" bash -c \
  "cass models status --json | jq -e --arg m \"\${CASS_SEMANTIC_EMBEDDER:?}\" 'any(.models[]; .registry_name == \$m and .installed)'"
# `.semantic.can_search` is already true with the hash tier alone, which
# cass never uses unless asked; only the published quality tier is the model.
check "cass semantic search ready (needs a cass release with the ARM64 fix, upstream #467)" bash -c \
  "cass status --json | jq -e '.semantic.quality_tier_published'"
check "sbh status" sbh status --json
check "sbh ballast pool in ~/.ballast" test -d "$HOME/.ballast"
check "ntm deps" ntm deps

if (( failed )); then
  printf '\nSome checks failed. Services: pitchfork start agent-mail cm sbh; services setup: mise run fw:bootstrap\n' >&2
  exit 1
fi
printf '\nflywheel stack looks healthy\n'
