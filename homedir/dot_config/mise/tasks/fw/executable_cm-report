#!/usr/bin/env bash
#MISE description="cass-memory report: rules by origin (main session / subagent), queue backlog, traumas"
#
# Read-only. A rule's origin comes from its `sourceSessions`: Claude Code keeps a
# subagent's transcript under <session>/subagents/, so a path with /subagents/
# is a subagent session (Codex sessions have no subagent split). Subagent
# sessions are reflected on purpose, see sessionExcludePatterns in
# $CASS_MEMORY_HOME/config.yaml.

set -euo pipefail

home="${CASS_MEMORY_HOME:?CASS_MEMORY_HOME is not set}"
cd "$HOME"

printf 'Store %s (%s)\n\n' "$home" "$(git -C "$home" log -1 --format='last commit %cr: %s' 2>/dev/null || echo 'no commits')"

printf 'Rules by origin (active):\n'
yq -o=json '.bullets // []' "$home/playbook.yaml" | jq -r '
  map(select((.deprecated // false) | not))
  | map(((.sourceSessions // []) | map(test("/subagents/"))) as $s
        | if ($s | length) == 0 then "manual/starter"
          elif all($s[]; .) then "subagent"
          elif any($s[]; .) then "main + subagent"
          else "main session" end)
  | group_by(.) | map("  \(.[0]): \(length)") | .[]'
printf '  kinds: %s\n' "$(yq -o=json '.bullets // []' "$home/playbook.yaml" |
  jq -r 'map(select((.deprecated // false) | not)) | group_by(.kind) | map("\(.[0].kind // "?")=\(length)") | join(", ")')"

processed="$home/reflections/global.processed.log"
done_count="$( [[ -f "$processed" ]] && grep -c . "$processed" || echo 0)"
known="$(cass timeline --since 3650d --json | jq '[.groups[][] | .source_path] | unique | length')"
printf '\nQueue: %s of %s sessions processed (reflected or skipped as trivial)\n' "$done_count" "$known"
if [[ -s "$home/reflections/queue-failures.json" ]]; then
  jq -r 'to_entries | map(select(.value > 0)) | if length == 0 then empty else
    "Failing sessions (skipped at CM_REFLECT_MAX_FAILURES):", (.[] | "  \(.value)x \(.key)") end' \
    "$home/reflections/queue-failures.json"
fi
printf 'cm-reflect daemon: %s\n' "$(pitchfork status cm-reflect 2>/dev/null | grep -m1 -E '^Status' || echo 'unknown')"

printf '\nTraumas: %s active' "$(cm trauma list --json 2>/dev/null | jq '.data.traumas // [] | length')"
if [[ -f "$home/trauma-candidates.md" ]]; then
  printf ', %s candidate(s) waiting in %s' "$(grep -c '^### ' "$home/trauma-candidates.md")" "$home/trauma-candidates.md"
fi
printf '\n'
