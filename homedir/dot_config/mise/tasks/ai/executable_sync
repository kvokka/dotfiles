#!/usr/bin/env bash
#MISE description="Generate global MCP servers and hooks for every AI client (rulesync)"
#
# Sources: ~/.config/rulesync/base/.rulesync on every machine, plus
# ~/.config/rulesync/fw/.rulesync where the flywheel stack is installed (the
# Linux devcontainer). Output: each client's user-scope files; rulesync replaces
# only its own keys in them (`mcpServers`, `hooks`, `[mcp_servers]`, `mcp`) and
# keeps the rest.
#
# Hooks are generated only when the fw tree exists: without a hooks source,
# rulesync would write an empty hook list and erase the clients' hooks.

set -euo pipefail

root="$HOME/.config/rulesync"
roots=("$root/base/.rulesync")
features="mcp"
if [[ -d "$root/fw/.rulesync" ]]; then
  roots+=("$root/fw/.rulesync")
  features="mcp,hooks"
fi

# rulesync cannot parse an empty mcp_config.json, which agy leaves as 0 bytes.
agy_mcp="$HOME/.gemini/config/mcp_config.json"
if [[ -f "$agy_mcp" && ! -s "$agy_mcp" ]]; then
  printf '{}\n' >"$agy_mcp"
fi

cd "$root"
exec rulesync generate --global \
  --targets claudecode,codexcli,opencode,antigravity-cli \
  --features "$features" \
  --input-roots "${roots[@]}"
