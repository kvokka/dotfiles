[bootstrap.user]

login_shell = "/usr/bin/zsh"

[bootstrap.hooks.post-user]
run = '[ "$(getent passwd root | cut -d: -f7)" = /usr/bin/zsh ] || sudo usermod -s /usr/bin/zsh root'

[bootstrap.groups.docker]
system = true

[bootstrap.groups.ubuntu]

[bootstrap.users.ubuntu]
group = "ubuntu"
groups = ["docker"]
shell = "/usr/bin/zsh"

[bootstrap.files."/etc/locale.gen"]
content = "en_US.UTF-8 UTF-8\n"
owner = "root"
group = "root"
mode = "0644"

[bootstrap.files."/etc/default/locale"]
content = """
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8
"""
owner = "root"
group = "root"
mode = "0644"
replace = true

[tools]

"github:pingdotgg/t3code" = "0.1"

[settings]

auto_update = true

# sshd for the host's `ssh docker-container` (compose publishes 2222 as 22).
# The host logs in with the key of the `ssh_agent_*` compose secrets, so the
# mounted public key is the only authorized key.
[bootstrap.packages]
"apt:openssh-server" = "latest"

# The drop-in dir comes with openssh-server, which a bootstrap that skips
# packages does not install.
[bootstrap.directories."/etc/ssh/sshd_config.d"]
owner = "root"
group = "root"
mode = "0755"

[bootstrap.files."/etc/ssh/sshd_config.d/devcontainer.conf"]
content = """
AllowUsers {{ .chezmoi.username }}
PasswordAuthentication no
AuthorizedKeysFile .secrets/ssh/{{ .github_login }}-agent.pub
HostKey {{ .chezmoi.homeDir }}/.local/state/sshd/ssh_host_ed25519_key
"""
owner = "root"
group = "root"
mode = "0644"

# The host key lives in the `home` volume: the one apt generates in /etc/ssh
# changes with every new container, and the host's ssh would refuse it. The
# container has no systemd to create sshd's privilege separation dir.
[daemons.sshd]
run = """
key=~/.local/state/sshd/ssh_host_ed25519_key
[ -f "$key" ] || { mkdir -p -m 700 "${key%/*}" && ssh-keygen -q -t ed25519 -N '' -f "$key"; }
sudo mkdir -p /run/sshd
exec sudo /usr/sbin/sshd -D -e
"""
dir = "~"
ready_port = 22
retry = true
auto = ["start"]

# T3 Code server, for the desktop and web clients and for T3 Connect (remote
# access through the T3 account; its link and token live in
# ~/.t3/userdata/secrets). Not `t3 up` or `t3 service install`: they need a
# systemd user manager. `t3` comes from mise, so the server runs the pinned
# version, and `watch` restarts it once mise installs another one, which stops
# running agent turns. pitchfork expands no `~` or variables in `watch`, hence
# the rendered path. Never `t3 update`: it installs into ~/.t3/runtime, which
# this daemon does not run. The fixed port is for `ready_port` and the compose
# publish (the default takes the first free port from 3773); `--lan` binds
# 0.0.0.0 and accepts private networks only, so the host and its LAN reach it
# with a pairing code (`t3 pair`). `fnox exec` hands the server, and every
# agent and terminal it starts, the secrets of the fnox profile (such as the
# MY_CLI_LLM_PROXY_API_KEY that Codex's `env_key` reads): the daemon misses the
# shell's `fnox activate`, and t3 takes only PATH from a login shell. A secret
# added to fnox reaches the agents after `pitchfork restart` of this daemon.
[daemons.t3]
run = "exec fnox exec -- t3 serve --port 3773 --lan"
dir = "~"
ready_port = 3773
watch = ["{{ .chezmoi.homeDir }}/.local/share/mise/installs/github-pingdotgg-t3code/*/t3"]
retry = true
auto = ["start"]

{{ if eq .github_login "kvokka" -}}
# Start on demand with `mise -C ~ daemons start loop-manager-dev`. The checkout supplies
# the toolchain and devloop/lm selects the installed binary, state directory and socket.
[daemons.loop-manager-dev]
dir = "~/proj/work/loop-manager"
run = "exec mise exec -- ./devloop/lm daemon --config devloop/config.toml"

{{ end -}}
