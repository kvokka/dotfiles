# MCP Agent Mail service settings (managed by chezmoi). Read by `am` itself;
# STORAGE_ROOT is additionally exported by ~/.config/mise/config.fw.toml so the
# pre-commit guard sees the same archive as the service.
STORAGE_ROOT={{ .chezmoi.homeDir }}/proj/share/agent-mail/git_mailbox_repo
DATABASE_URL=sqlite:///{{ .chezmoi.homeDir }}/proj/share/agent-mail/storage.sqlite3
HTTP_HOST=127.0.0.1
HTTP_PORT=8765
HTTP_ALLOWED_HOSTS=host.docker.internal,host-gateway
HTTP_ALLOW_LOCALHOST_UNAUTHENTICATED=true
