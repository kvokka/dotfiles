# MCP Agent Mail service settings (managed by chezmoi). Read by `am` itself;
# STORAGE_ROOT is additionally exported by ~/.config/mise/config.fw.toml so the
# pre-commit guard sees the same archive as the service.
STORAGE_ROOT={{ .chezmoi.homeDir }}/proj/share/agent-mail/git_mailbox_repo
DATABASE_URL=sqlite:///{{ .chezmoi.homeDir }}/proj/share/agent-mail/storage.sqlite3
# 0.0.0.0: the devcontainer publishes 8765 (docker-compose local-dev) and
# OrbStack exposes the container as console.local-dev.orb.local, so the host
# reaches the server as localhost:8765 or console.local-dev.orb.local:8765.
# Loopback names are always accepted; every other Host header must be listed.
# No bearer token: the server is unauthenticated on the compose network and to
# the host, which is the local-dev intent; set HTTP_BEARER_TOKEN before
# exposing it any further.
HTTP_HOST=0.0.0.0
HTTP_PORT=8765
HTTP_ALLOWED_HOSTS=host.docker.internal,host-gateway,console.local-dev.orb.local
HTTP_ALLOW_LOCALHOST_UNAUTHENTICATED=true
# Product bus on: fetch_inbox_product, search_messages_product and
# summarize_thread_product read across the projects of a product, which is how
# an agent registered in several repositories reads one inbox (agent-mail.md,
# "Across repositories"). The flag is misnamed: it gates the product bus and
# the build slots, nothing about git worktrees.
WORKTREES_ENABLED=true
# Hide the build slot tools (3) from tools/list: only `am am-run` and
# `am verify` take those leases. Read once at start; a change needs
# `pitchfork restart agent-mail`.
TOOLS_FILTER_ENABLED=true
TOOLS_FILTER_PROFILE=custom
TOOLS_FILTER_MODE=exclude
TOOLS_FILTER_CLUSTERS=build_slots
# Prune from the live database, hourly, the messages that every recipient has
# read and, where required, acknowledged, once they are older than two days;
# the git archive keeps them. The default 0 keeps every message forever.
MESSAGES_RETENTION_DAYS=2
