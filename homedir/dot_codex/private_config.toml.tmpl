suppress_unstable_features_warning = true # stub default_mode_request_user_input
model = "gpt-6-astra"
model_reasoning_effort = "high"
approval_policy = "never"
sandbox_mode = "danger-full-access"
web_search = "cached"
file_opener = "vscode"

model_provider = "myproxy"

[model_providers.myproxy]
# Have to use chezmoi interpolation since it does not support it from env var
base_url = {{ .my_cli_llm_proxy.url | quote }}

name = "My Proxy for Codex"
wire_api = "responses"

env_key = "MY_CLI_LLM_PROXY_API_KEY"

[history]
persistence = "save-all"
max_bytes = 104857600 # 100 MiB

[projects."/workspace"]
trust_level = "trusted"

[projects."/home/ubuntu/proj/active/"]
trust_level = "trusted"

[tui]
# Send desktop notifications when approvals are required or a turn completes.
# Defaults to false.
notifications = true
status_line = [
  "model-with-reasoning",
  "context-remaining",
  "current-dir",
  "weekly-limit",
]

[tui.model_availability_nux]
"gpt-5.5" = 4
"gpt-5.6-sol" = 4

[analytics]
enabled = false

[feedback]
enabled = false

[features]
multi_agent = true
search_tool = true
fast_mode = true
terminal_resize_reflow = true
prevent_idle_sleep = true
plugins = true # required for claude plugins
default_mode_request_user_input = true # required for kvokka/codex-cli
memories = false

[agents]
max_threads = 15
max_depth = 2
job_max_runtime_seconds = 1800

[tools]
view_image = true

{{ if or (eq .github_login "kvokka") (eq .github_login "kvokka-agent")  }}
[marketplaces."siam-platform"]
source_type = "git"
source = "https://github.com/umum-ai/siam-platform.git"

# TODO: After maturity of this plugin exctract it to the separate marketplace/plugin
#       with pubic scope
[plugins."engineering@siam-platform"]
enabled = true

# With codex 0.149.1 this DOES NOT override global config because of codex bug!
# kept it just to make it explisit. Have edit global codex config
# TODO: make this project-related, not global
[plugins."org@siam-platform"]
enabled = true
{{ end }}

{{ $codex_active_repos := list
  "siam-platform"
  "codex-mcp"
  "siam-api"
  "siam-app"
  "siam-ocr"
  "siam-web"
  "siam-telemetry"
  "siam-staging-provisioner"
  "siam-plugins"
  "siam-infra"
  "siam-image-prepare"  -}}

{{ range $codex_active_repos -}}
[projects."/home/ubuntu/proj/active/{{ . }}"]
trust_level = "trusted"

{{ end -}}

[hooks.state]
