{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "//": [
    "TODO: move siam-orchestration@siam to the project level",
    "TODO: move CODEX_MCP_ALLOWED_AGENTS to siam env after testing is done"
  ],
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "EndConversation",
      "NotebookEdit",
      "DesignSync",
      "Agent(statusline-setup)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 60
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "5",
    "CODEX_MCP_ALLOWED_AGENTS": "engineering:librarian,engineering:critic"
  },
  "model": "opus[1m]",
  "worktree": {
    "baseRef": "fresh"
  },
  "enabledPlugins": {
    "siam-orchestration@siam": true,
    "engineering@siam": true,
    "frontend-design@claude-plugins-official": true,
    "codex-mcp@codex-mcp": true,
    "pohuy@pohuy": true
  },
  "extraKnownMarketplaces": {
    "siam": {
      "source": {
        "source": "github",
        "repo": "umum-ai/siam-plugins"
      },
      "autoUpdate": true
    },
    "pohuy": {
      "source": {
        "source": "github",
        "repo": "smixs/pohuy"
      }
    },
    "codex-mcp": {
      "source": {
        "source": "git",
        "url": "https://github.com/kvokka/codex-mcp.git"
      },
      "autoUpdate": true
    }
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-fable-5": {
      "effortLevel": "xhigh"
    }
  },
  "language": "Русский",
  "effortLevel": "high",
  "askUserQuestionTimeout": "never",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "feedbackDrafts": "off",
  "skillOverrides": {
    "run": "off",
    "init": "off"
  }
}
