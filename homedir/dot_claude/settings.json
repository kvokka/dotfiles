{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "worktree": {
    "baseRef": "fresh"
  },
  "enabledPlugins": {
    "siam-orchestration@siam": true,
    "engineering@siam": true,
    "frontend-design@claude-plugins-official": false,
    "codex@openai-codex": true,
    "pohuy@pohuy": true
  },
  "extraKnownMarketplaces": {
    "siam": {
      "source": {
        "source": "github",
        "repo": "umum-ai/siam-plugins"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "pohuy": {
      "source": {
        "source": "github",
        "repo": "smixs/pohuy"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-fable-5": {
      "effortLevel": "xhigh"
    }
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3" // starting from level 0
  },
  "language": "Русский",
  "effortLevel": "high",
  "askUserQuestionTimeout": "never",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
