{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 99999,
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "5"
  },
  "permissions": {
    "deny": [
      "EndConversation",
      "NotebookEdit",
      "DesignSync",
      "Agent(statusline-setup)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5-1",
  "skillOverrides": {
    "run": "off",
    "init": "off"
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "org@siam-platform": false,
    "engineering@siam-platform": false,
    "frontend-design@claude-plugins-official": false,
    "claude-codex-bridge@claude-codex-bridge": false,
    "pohuy@pohuy": false,
    "telemetry@builtin": false
  },
  "extraKnownMarketplaces": {
    "siam-platform": {
      "source": {
        "source": "github",
        "repo": "umum-ai/siam-platform"
      },
      "autoUpdate": true
    },
    "pohuy": {
      "source": {
        "source": "github",
        "repo": "smixs/pohuy"
      }
    },
    "claude-codex-bridge": {
      "source": {
        "source": "github",
        "repo": "umum-ai/claude-codex-bridge"
      },
      "autoUpdate": true
    }
  },
  "language": "Русский",
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "askUserQuestionTimeout": "never",
  "channelsEnabled": true,
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "//": [
    "TODO: move siam-orchestration@siam to the project level"
  ]
}
