{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "//": [
    "TODO: move siam-orchestration@siam to the project level"
  ],
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "EndConversation",
      "NotebookEdit",
      "DesignSync",
      "Agent(statusline-setup)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 60
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "5"
  },
  "model": "opus[1m]",
  "worktree": {
    "baseRef": "fresh"
  },
  "enabledPlugins": {
    "siam-orchestration@siam": true,
    "engineering@siam": true,
    "frontend-design@claude-plugins-official": true,
    "claude-codex-bridge@claude-codex-bridge": true,
    "pohuy@pohuy": true
  },
  "extraKnownMarketplaces": {
    "siam": {
      "source": {
        "source": "github",
        "repo": "umum-ai/siam-plugins"
      },
      "autoUpdate": true
    },
    "pohuy": {
      "source": {
        "source": "github",
        "repo": "smixs/pohuy"
      }
    },
    "claude-codex-bridge": {
      "source": {
        "source": "github",
        "repo": "umum-ai/claude-codex-bridge"
      },
      "autoUpdate": true
    }
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "language": "Русский",
  "effortLevel": "high",
  "askUserQuestionTimeout": "never",
  "channelsEnabled": true,
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "feedbackDrafts": "off",
  "skillOverrides": {
    "run": "off",
    "init": "off"
  }
}
