{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PONYTAIL_SUBAGENT_MATCHER": "^(general-purpose|coder|expert)$",
    "CLAUDE_CODE_EXPERIMENTAL_CODE_MODE": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3"
  },
  "permissions": {
    "deny": [
      "EndConversation",
      "NotebookEdit",
      "DesignSync",
      "Agent(statusline-setup)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "run": "off",
    "init": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off"
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "frontend-design@claude-plugins-official": false,
    "pohuy@pohuy": false,
    "telemetry@builtin": false,
    "t3-run-card@loop-manager": true,
    "loop-manager@loop-manager": true
  },
  "extraKnownMarketplaces": {
    "loop-manager": {
      "source": {
        "source": "github",
        "repo": "kvokka/loop-manager"
      },
      "autoUpdate": true
    },
    "pohuy": {
      "source": {
        "source": "github",
        "repo": "smixs/pohuy"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      },
      "autoUpdate": true
    }
  },
  "language": "Русский",
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-2": {
      "effortLevel": "high"
    }
  },
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-or-agents-md"
      }
    },
    "ponytail@ponytail": {
      "options": {
        "ledger": true,
        "sendNames": true
      }
    },
    "t3-run-card@loop-manager": {
      "options": {
        "auto_open": true
      }
    }
  },
  "enableArtifact": false,
  "askUserQuestionTimeout": "never",
  "channelsEnabled": true,
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "switchModelsOnFlag": true,
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "awaySummaryEnabled": false,
  "idleCompaction": false
}
