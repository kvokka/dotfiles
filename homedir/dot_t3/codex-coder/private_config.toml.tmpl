# CODEX_HOME of the T3 provider instance codex-coder: the host's provider and model, plus kvokka-harness-plugins.
model = "gpt-6.2-sol"
model_context_window = 600_000
model_reasoning_effort = "high"
# The harness compacts at 600k; the context-budget plugin warns at 300k and stops at 420k.
model_auto_compact_token_limit = 600_000
approval_policy = "never"
sandbox_mode = "danger-full-access"
web_search = "cached"
model_provider = "myproxy"

[model_providers.myproxy]
# Have to use chezmoi interpolation since it does not support it from env var
base_url = {{ .my_cli_llm_proxy.url | quote }}
name = "My Proxy for Codex"
wire_api = "responses"
env_key = "MY_CLI_LLM_PROXY_API_KEY"

[analytics]
enabled = false

[feedback]
enabled = false

[features]
plugins = true
memories = false

[agents]
max_threads = 15
max_depth = 2

{{ $codex_active_repos := list
  "proj/work"
  ".dotfiles"  -}}

{{ range $codex_active_repos -}}
[projects."/home/ubuntu/proj/work/{{ . }}"]
trust_level = "trusted"

{{ end }}

[marketplaces.kvokka-harness-plugins]
source_type = "git"
source = "https://github.com/kvokka/kvokka-harness-plugins.git"

[plugins."dcg@kvokka-harness-plugins"]
enabled = true

[plugins."conventional-commits@kvokka-harness-plugins"]
enabled = true

[plugins."context-budget@kvokka-harness-plugins"]
enabled = true

[plugins."shell-tools@kvokka-harness-plugins"]
enabled = true

[plugins."agent-mail@kvokka-harness-plugins"]
enabled = true

[plugins."cache-warm@kvokka-harness-plugins"]
enabled = true

[marketplaces.ponytail]
source_type = "git"
source = "https://github.com/DietrichGebert/ponytail.git"

[plugins."ponytail@ponytail"]
enabled = true
